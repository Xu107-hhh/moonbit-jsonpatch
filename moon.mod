name = "Xu107-hhh/moonbit-jsonpatch"

version = "0.1.0"

readme = "README.mbt.md"

repository = "https://github.com/Xu107-hhh/moonbit-jsonpatch"

license = "Apache-2.0"

keywords = [
  "json-patch",
  "json-pointer",
  "json-merge-patch",
  "json",
  "rfc6902",
]

preferred_target = "wasm"

description = "RFC 6902 JSON Patch (apply + diff) and RFC 7386 JSON Merge Patch for MoonBit, with RFC 6901 JSON Pointer support and precise error reporting."
