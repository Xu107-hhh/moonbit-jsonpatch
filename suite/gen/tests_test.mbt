///|
test "tests_092_Patch_with_different_capitalisation_than_doc" {
  // Patch with different capitalisation than doc
  let doc : Json = parse_fixture("{\"foo\":\"bar\"}")
  let patch : Json = parse_fixture(
    "[{\"op\":\"add\",\"path\":\"/FOO\",\"value\":\"BAR\"}]",
  )
  let expected : Json = parse_fixture("{\"foo\":\"bar\",\"FOO\":\"BAR\"}")
  inspect(@jsonpatch.json_equal(apply_ok(doc, patch), expected), content="true")
}

///|
test "tests_093_test_copy_object_then_change_destination" {
  // test copy object then change destination
  let doc : Json = parse_fixture(
    "{\"foo\":{\"bar\":{\"baz\":[{\"boo\":\"net\"}]}}}",
  )
  let patch : Json = parse_fixture(
    "[{\"op\":\"copy\",\"from\":\"/foo\",\"path\":\"/bak\"},{\"op\":\"replace\",\"path\":\"/bak/bar/baz/0/boo\",\"value\":\"qux\"}]",
  )
  let expected : Json = parse_fixture(
    "{\"foo\":{\"bar\":{\"baz\":[{\"boo\":\"net\"}]}},\"bak\":{\"bar\":{\"baz\":[{\"boo\":\"qux\"}]}}}",
  )
  inspect(@jsonpatch.json_equal(apply_ok(doc, patch), expected), content="true")
}

///|
test "tests_094_test_copy_object_then_change_source" {
  // test copy object then change source
  let doc : Json = parse_fixture(
    "{\"foo\":{\"bar\":{\"baz\":[{\"boo\":\"net\"}]}}}",
  )
  let patch : Json = parse_fixture(
    "[{\"op\":\"copy\",\"from\":\"/foo\",\"path\":\"/bak\"},{\"op\":\"replace\",\"path\":\"/foo/bar/baz/0/boo\",\"value\":\"qux\"}]",
  )
  let expected : Json = parse_fixture(
    "{\"foo\":{\"bar\":{\"baz\":[{\"boo\":\"qux\"}]}},\"bak\":{\"bar\":{\"baz\":[{\"boo\":\"net\"}]}}}",
  )
  inspect(@jsonpatch.json_equal(apply_ok(doc, patch), expected), content="true")
}
