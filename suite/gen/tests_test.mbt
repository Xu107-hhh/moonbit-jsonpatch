  )
  let patch : Json = parse_fixture(
    "[{\"op\":\"test\",\"path\":\"/foo\",\"value\":[\"bar\",\"baz\"]},{\"op\":\"test\",\"path\":\"/foo/0\",\"value\":\"bar\"},{\"op\":\"test\",\"path\":\"/\",\"value\":0},{\"op\":\"test\",\"path\":\"/a~1b\",\"value\":1},{\"op\":\"test\",\"path\":\"/c%d\",\"value\":2},{\"op\":\"test\",\"path\":\"/e^f\",\"value\":3},{\"op\":\"test\",\"path\":\"/g|h\",\"value\":4},{\"op\":\"test\",\"path\":\"/i\\\\j\",\"value\":5},{\"op\":\"test\",\"path\":\"/k\\\"l\",\"value\":6},{\"op\":\"test\",\"path\":\"/ \",\"value\":7},{\"op\":\"test\",\"path\":\"/m~0n\",\"value\":8}]",
  )
  let expected : Json = parse_fixture(
    "{\"\":0,\" \":7,\"a/b\":1,\"c%d\":2,\"e^f\":3,\"foo\":[\"bar\",\"baz\"],\"g|h\":4,\"i\\\\j\":5,\"k\\\"l\":6,\"m~n\":8}",
  )
  inspect(@jsonpatch.json_equal(apply_ok(doc, patch), expected), content="true")
}

///|
test "tests_059_Move_to_same_location_has_no_effect" {
  // Move to same location has no effect
  let doc : Json = parse_fixture("{\"foo\":1}")
  let patch : Json = parse_fixture(
    "[{\"op\":\"move\",\"from\":\"/foo\",\"path\":\"/foo\"}]",
  )
  let expected : Json = parse_fixture("{\"foo\":1}")
  inspect(@jsonpatch.json_equal(apply_ok(doc, patch), expected), content="true")
}

///|
test "tests_060_case" {
  let doc : Json = parse_fixture("{\"foo\":1,\"baz\":[{\"qux\":\"hello\"}]}")
  let patch : Json = parse_fixture(
    "[{\"op\":\"move\",\"from\":\"/foo\",\"path\":\"/bar\"}]",
  )
  let expected : Json = parse_fixture(
    "{\"baz\":[{\"qux\":\"hello\"}],\"bar\":1}",
  )
  inspect(@jsonpatch.json_equal(apply_ok(doc, patch), expected), content="true")
}

///|
test "tests_061_case" {
  let doc : Json = parse_fixture("{\"baz\":[{\"qux\":\"hello\"}],\"bar\":1}")
  let patch : Json = parse_fixture(
    "[{\"op\":\"move\",\"from\":\"/baz/0/qux\",\"path\":\"/baz/1\"}]",
  )
  let expected : Json = parse_fixture("{\"baz\":[{},\"hello\"],\"bar\":1}")
  inspect(@jsonpatch.json_equal(apply_ok(doc, patch), expected), content="true")
}

///|
test "tests_062_case" {
  let doc : Json = parse_fixture("{\"baz\":[{\"qux\":\"hello\"}],\"bar\":1}")
  let patch : Json = parse_fixture(
    "[{\"op\":\"copy\",\"from\":\"/baz/0\",\"path\":\"/boo\"}]",
  )
  let expected : Json = parse_fixture(
    "{\"baz\":[{\"qux\":\"hello\"}],\"bar\":1,\"boo\":{\"qux\":\"hello\"}}",
  )
  inspect(@jsonpatch.json_equal(apply_ok(doc, patch), expected), content="true")
}

///|
test "tests_063_replacing_the_root_of_the_document_is_possible_with_add" {
  // replacing the root of the document is possible with add
  let doc : Json = parse_fixture("{\"foo\":\"bar\"}")
  let patch : Json = parse_fixture(
    "[{\"op\":\"add\",\"path\":\"\",\"value\":{\"baz\":\"qux\"}}]",
  )
  let expected : Json = parse_fixture("{\"baz\":\"qux\"}")
  inspect(@jsonpatch.json_equal(apply_ok(doc, patch), expected), content="true")
}

///|
test "tests_064_Adding_to_adds_to_the_end_of_the_array" {
  // Adding to "/-" adds to the end of the array
  let doc : Json = parse_fixture("[1,2]")
  let patch : Json = parse_fixture(
    "[{\"op\":\"add\",\"path\":\"/-\",\"value\":{\"foo\":[\"bar\",\"baz\"]}}]",
  )
  let expected : Json = parse_fixture("[1,2,{\"foo\":[\"bar\",\"baz\"]}]")
  inspect(@jsonpatch.json_equal(apply_ok(doc, patch), expected), content="true")
}

///|
test "tests_065_Adding_to_adds_to_the_end_of_the_array_even_n_levels_down" {
  // Adding to "/-" adds to the end of the array, even n levels down
  let doc : Json = parse_fixture("[1,2,[3,[4,5]]]")
  let patch : Json = parse_fixture(
    "[{\"op\":\"add\",\"path\":\"/2/1/-\",\"value\":{\"foo\":[\"bar\",\"baz\"]}}]",
  )
  let expected : Json = parse_fixture(
    "[1,2,[3,[4,5,{\"foo\":[\"bar\",\"baz\"]}]]]",
  )
  inspect(@jsonpatch.json_equal(apply_ok(doc, patch), expected), content="true")
}

